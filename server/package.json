{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:auth": "vitest run tests/auth",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:claude": "cross-env ENV_FILE=.env.claude ts-node-dev --respawn --transpile-only src/server.ts",
    "prebuild": "npm run build -w @lyra/shared",
    "build": "swc src --out-dir dist --strip-leading-paths",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "migrate:cents": "ts-node scripts/migrateToCents.ts",
    "migrate:fingerprint": "ts-node scripts/backfillImportFingerprint.ts",
    "migrate:workspaces": "ts-node scripts/migrate-workspaces.ts",
    "restore:backup": "ts-node scripts/restore-backup.ts",
    "seed:invitations": "ts-node scripts/seed-invitation-states.ts",
    "clean:invitations": "ts-node scripts/clean-invitations.ts",
    "backfill:personal-icon": "ts-node scripts/backfill-personal-workspace-icon.ts",
    "mint:shortcut-token": "ts-node scripts/mintShortcutToken.ts",
    "stats:adoption": "ts-node scripts/adoption-stats.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@lyra/shared": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "archiver": "7.0.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.1",
    "multer": "2.1.1",
    "resend": "^6.6.0",
    "xlsx": "0.18.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.18",
    "@types/adm-zip": "0.5.8",
    "@types/archiver": "6.0.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "2.1.0",
    "@types/node": "^24.5.0",
    "@types/supertest": "7.2.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "adm-zip": "0.5.17",
    "cross-env": "7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "supertest": "7.3.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
